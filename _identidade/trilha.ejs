```{=html}
<%
  // Template das seções de materiais de uma disciplina.
  // Cada item vira um nó da trilha, numerado pela unidade.
  const tipo = (typeof templateParams !== 'undefined' && templateParams.tipo) || 'textos';
  const icones = { slides: 'bi-easel', textos: 'bi-journal-text', labs: 'bi-terminal', podcasts: 'bi-mic', palestras: 'bi-camera-video' };
  const vazio = {
    slides: 'Os slides desta disciplina serão publicados ao longo do semestre.',
    textos: 'Os textos de apoio serão publicados ao longo do semestre.',
    labs: 'Os laboratórios serão publicados ao longo do semestre.',
    podcasts: 'Nenhum episódio publicado ainda para esta disciplina.',
    palestras: 'Nenhuma palestra publicada ainda para esta disciplina.'
  };
%>
<% if (items.length === 0) { %>
<p class="cc-vazio"><%= vazio[tipo] %></p>
<% } else { %>
<ol class="cc-trilha">
<% for (const item of items) { %>
  <li class="cc-trilha-item" <%= metadataAttrs(item) %>>
    <span class="cc-no" aria-hidden="true"><% if (item.unidade) { %><%= item.unidade %><% } else { %><i class="bi <%= icones[tipo] %>"></i><% } %></span>
    <div>
      <a class="cc-trilha-titulo" href="<%- item.path %>"><% if (item.unidade) { %><span class="visually-hidden">Unidade <%= item.unidade %>: </span><% } %><%= item.title %></a>
      <% if (item.description) { %><p class="cc-trilha-desc"><%= item.description %></p><% } %>
      <div class="cc-trilha-meta">
        <% if (item.duracao) { %><span><i class="bi bi-clock" aria-hidden="true"></i><%= item.duracao %></span><% } %>
        <% if (tipo === 'slides') { %><a href="<%- item.path.replace(/\.qmd$/, ".html") %>?print-pdf" target="_blank" rel="noopener"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>Versão para PDF</a><% } %>
        <% if (tipo === 'labs') { %><a href="https://colab.research.google.com/github/{{< var github.repositorio >}}/blob/main<%- item.path %>" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>Abrir no Colab</a><% } %>
      </div>
    </div>
  </li>
<% } %>
</ol>
<% } %>
```
